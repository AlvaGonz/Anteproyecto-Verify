# Ignore most files
**/*

# Explicitly allow source files needed for build
!docker/
!src/
!Build-Database-Sql.sql
!.env
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!*.sln
!*.csproj
!tsconfig.json
!vite.config.ts
!playwright.config.ts

# Ignore nested items
docker/**
!docker/SQL_Server/
!docker/SQL_Server/Dockerfile
!docker/SQL_Server/entrypoint.sh
!docker/SQL_Server/translate.py
!docker/api.dev.Dockerfile
!docker/web.dev.Dockerfile
!docker/azurite.Dockerfile
!docker/nginx.conf

# Exclude build artifacts deeply
**/bin/
**/obj/
**/dist/
**/dist-ssr/
**/node_modules/
**/.git/
**/.vscode/
**/.DS_Store/
**/Thumbs.db
