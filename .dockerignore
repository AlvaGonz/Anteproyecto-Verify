# Ignore most files
**/*

# Exclude build artifacts deeply
**/bin/
**/obj/
**/dist/
**/dist-ssr/
**/node_modules/
node_modules/
node_modules
**/.git/
**/.vscode/
**/.DS_Store/
**/Thumbs.db

# Ignore nested items
docker/**
!docker/SQL_Server/
!docker/SQL_Server/Dockerfile
!docker/SQL_Server/entrypoint.sh
!docker/SQL_Server/translate.py
!docker/api.dev.Dockerfile
!docker/web.dev.Dockerfile
!docker/azurite.Dockerfile
!docker/nginx.conf

# Explicitly allow source files needed for build (must come after exclusions)
!docker/
!docker/api-publish/
!src/backend/
!src/frontend/web/src/
!src/frontend/web/public/
!src/frontend/web/index.html
!src/frontend/web/package.json
!src/frontend/web/tsconfig*
!src/frontend/web/vite.config.ts
!src/backend/Api/bin/
!src/backend/Api/obj/
!Build-Database-Sql.sql
!.env
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!*.sln
!*.csproj
!tsconfig.json
!vite.config.ts
!playwright.config.ts